{
  "name": "quzz",
  "version": "1.0.0",
  "description": "Debug React Server Components like a pro. Zero config, instant insights, maximum productivity.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./visualizer/trace-collector": {
      "types": "./dist/visualizer/trace-collector.d.ts",
      "import": "./dist/visualizer/trace-collector.mjs",
      "require": "./dist/visualizer/trace-collector.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nextjs",
    "react",
    "server-components",
    "rsc",
    "debugging",
    "tracing",
    "hoc",
    "development",
    "production",
    "performance",
    "monitoring",
    "debugging",
    "tracing",
    "hoc"
  ],
  "homepage": "https://github.com/onurhan1337/quzz",
  "bugs": {
    "url": "https://github.com/onurhan1337/quzz/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/onurhan1337/quzz"
  },
  "author": "Onurhan Demir",
  "license": "MIT",
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "esbuild": "^0.27.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.7",
    "next": "^15.5.7",
    "prettier": "^3.4.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
